<idea-plugin>
    <id>dev.schemalock</id>
    <name>SchemaLock</name>
    <vendor url="https://schemalock.dev">SchemaLock</vendor>
    <description><![CDATA[
        Versioned, integrity-pinned schemas for YAML files.<br/>
        Provides autocomplete and validation for Kubernetes CRDs and other ecosystems
        from <a href="https://cdn.schemalock.dev">cdn.schemalock.dev</a>.
        Pin schema versions per directory with an optional <code>schemalock.yaml</code> file;
        unpinned resources resolve to the latest version from the CDN.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.yaml</depends>

    <extensions defaultExtensionNs="com.intellij">
        <platform.lsp.serverSupportProvider
            implementation="dev.schemalock.intellij.SchemalockLspServerSupportProvider"/>
        <statusBarWidgetFactory
            id="SchemalockDocumentStatus"
            implementation="dev.schemalock.intellij.DocumentStatusWidgetFactory"
            order="after Position"/>
        <lang.inspectionSuppressor
            language="yaml"
            implementationClass="dev.schemalock.intellij.SchemalockInspectionSuppressor"/>
    </extensions>
</idea-plugin>
